# Audit working material (local only, never public)
.lattice-audit/
Audit_Prompt/

# Project docs are not part of the npm tarball (package.json "files" decides
# that). They stay out of git by default, with the publication policy as the
# one tracked exception: it must reach every clone. Use docs/* (not docs/) so
# the negation below can take effect -- git cannot re-include a file whose
# parent DIRECTORY is excluded.
docs/*
!docs/PUBLICATION_BOUNDARIES.md
Regras/

# Secrets and credentials
.env
.env.*
*.pem
*.key
*.p12
plow-credentials*

# Runtime state and databases
lattice.db
lattice.db-wal
lattice.db-shm
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
lattice.product.json

# Local Agent Index / Plow integration state
.agent-index/
agent-index-client/
agentsview-bin/
lattice-pack-*
.export-*
usage.jsonl

# Logs, traces and dumps
*.log
logs/
*.trace
dumps/

# Build and cache output (rebuilt by CI/pack)
node_modules/
dist/
*.tgz
*.tsbuildinfo
coverage/
tmp/

# Test artifacts and screenshots
artifacts/
test-results/
playwright-report/

# Local agent/tooling artifacts (see docs/PUBLICATION_BOUNDARIES.md).
# These stay on the machine: tools keep working, nothing of theirs is published.
.trail/
.mcp.json
.claude/
.codex/
.cursor/
.opencode/
.continue/
.aider*

# IDE and OS files
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
